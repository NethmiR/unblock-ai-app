# Root .gitignore for the unblock-ai monorepo.
# Merged from unblock-ai-api/.gitignore and unblock-ai-web/.gitignore.
# Patterns are intentionally un-anchored so they match inside any sub-project.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# build output
dist/
build/
out/

# next.js
.next/
next-env.d.ts

# typescript
*.tsbuildinfo

# env files (can opt-in for committing if needed)
.env
.env*
!.example.env

# vercel
.vercel

# logs / debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem
