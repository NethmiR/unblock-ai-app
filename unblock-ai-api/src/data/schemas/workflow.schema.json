{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unblock-ai/schema/workflow.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "title",
    "description",
    "retrieval_summary",
    "scope",
    "requester",
    "inputs",
    "computed",
    "steps",
    "completion",
    "metadata"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "workflow_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "retrieval_summary": { "$ref": "#/$defs/retrieval_summary" },
    "scope": { "$ref": "#/$defs/scope" },
    "requester": { "$ref": "#/$defs/requester" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "computed": {
      "type": "array",
      "items": { "$ref": "#/$defs/computed" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "completion": { "$ref": "#/$defs/completion" },
    "metadata": { "$ref": "#/$defs/metadata" }
  },

  "$defs": {
    "retrieval_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_liner",
        "aliases",
        "keywords",
        "requester_types",
        "triggers",
        "not_for"
      ],
      "properties": {
        "one_liner": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "requester_types": { "type": "array", "items": { "type": "string" } },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "not_for": { "type": "array", "items": { "type": "string" } }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution_type", "applies_to"],
      "properties": {
        "institution_type": {
          "type": "string",
          "enum": ["university", "school", "company", "hospital", "government", "other"]
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_type", "constraints"],
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": ["student", "staff", "faculty", "external", "any"]
            },
            "constraints": {
              "type": "array",
              "items": { "$ref": "#/$defs/constraint" }
            }
          }
        }
      }
    },

    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "operator", "value"],
      "properties": {
        "attribute": { "type": "string" },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "not_in"]
        },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array", "items": { "type": ["string", "number"] } }
          ]
        }
      }
    },

    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "identifier_field"],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": ["student", "staff", "faculty", "external", "any"]
        },
        "identifier_field": { "type": "string" }
      }
    },

    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "role",
        "relative_to",
        "directory_query",
        "fallback_role",
        "display_name"
      ],
      "properties": {
        "resolution": {
          "type": "string",
          "enum": ["dynamic", "static", "requester", "system"]
        },
        "role": { "type": ["string", "null"] },
        "relative_to": { "type": ["string", "null"] },
        "directory_query": { "type": ["string", "null"] },
        "fallback_role": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] }
      }
    },

    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "type",
        "collected_from",
        "required",
        "validation",
        "collection_hint"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "type": {
          "type": "string",
          "enum": [
            "string", "text", "number", "date", "datetime",
            "boolean", "email", "phone", "enum", "file", "person"
          ]
        },
        "collected_from": { "$ref": "#/$defs/actor" },
        "required": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/validation" },
        "collection_hint": { "type": ["string", "null"] }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_length", "max_length", "min", "max",
        "not_before", "not_after", "not_before_field", "not_after_field", "pattern"
      ],
      "properties": {
        "min_length": { "type": ["integer", "null"] },
        "max_length": { "type": ["integer", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "not_before": { "type": ["string", "null"] },
        "not_after": { "type": ["string", "null"] },
        "not_before_field": { "type": ["string", "null"] },
        "not_after_field": { "type": ["string", "null"] },
        "pattern": { "type": ["string", "null"] }
      }
    },

    "computed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "operation", "arguments"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": ["string", "null"] },
        "operation": {
          "type": "string",
          "enum": [
            "date_diff_days", "sum", "difference",
            "multiply", "count", "lookup", "constant"
          ]
        },
        "arguments": { "$ref": "#/$defs/computedArguments" }
      }
    },

    "computedArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "inclusive", "values", "source", "key", "value"],
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] },
        "inclusive": { "type": ["boolean", "null"] },
        "values": {
          "type": "array",
          "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
        },
        "source": { "type": ["string", "null"] },
        "key": { "type": ["string", "null"] },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "left", "right", "clauses", "description"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "equals", "not_equals", "greater_than", "less_than",
            "greater_or_equal", "less_or_equal", "in", "not_in", "exists",
            "and", "or", "not"
          ]
        },
        "left": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "right": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "clauses": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "description": { "type": ["string", "null"] }
      }
    },

    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "required_outcome"],
      "properties": {
        "step_id": { "type": "string" },
        "required_outcome": { "type": "string" }
      }
    },

    "response_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "required_on_outcome"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "string", "text", "number", "date", "datetime",
            "boolean", "email", "phone", "enum", "file", "person"
          ]
        },
        "required_on_outcome": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "outcome_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "notify", "include_reason", "return_to_step", "prompt_source"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["continue", "terminate_workflow", "reopen_input"]
        },
        "notify": {
          "type": "array",
          "items": { "$ref": "#/$defs/actor" }
        },
        "include_reason": { "type": ["boolean", "null"] },
        "return_to_step": { "type": ["string", "null"] },
        "prompt_source": { "type": ["string", "null"] }
      }
    },

    "notification_setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "template"],
      "properties": {
        "channel": { "type": "string", "enum": ["email", "sms", "in_app"] },
        "template": { "type": "string" }
      }
    },

    "context_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "field", "as"],
      "properties": {
        "step_id": { "type": "string" },
        "field": { "type": "string" },
        "as": { "type": "string" }
      }
    },

    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reminder_after_hours", "escalate_after_hours"],
      "properties": {
        "reminder_after_hours": { "type": ["integer", "null"] },
        "escalate_after_hours": { "type": ["integer", "null"] }
      }
    },

    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "type", "description", "assignee", "depends_on",
        "initial_state", "blocked_reason", "condition",
        "instructions_to_approver", "response_fields", "context_from_steps",
        "outcomes", "notifications", "sla"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["approval", "notification", "data_collection", "automated_action", "review"]
        },
        "description": { "type": ["string", "null"] },
        "assignee": { "$ref": "#/$defs/actor" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        },
        "initial_state": {
          "type": "string",
          "enum": ["auto", "blocked"]
        },
        "blocked_reason": { "type": ["string", "null"] },
        "condition": {
          "anyOf": [
            { "$ref": "#/$defs/condition" },
            { "type": "null" }
          ]
        },
        "instructions_to_approver": { "type": ["string", "null"] },
        "response_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/response_field" }
        },
        "context_from_steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_binding" }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "rejected", "request_more_info"],
          "properties": {
            "approved": {
              "anyOf": [{ "$ref": "#/$defs/outcome_effect" }, { "type": "null" }]
            },
            "rejected": {
              "anyOf": [{ "$ref": "#/$defs/outcome_effect" }, { "type": "null" }]
            },
            "request_more_info": {
              "anyOf": [{ "$ref": "#/$defs/outcome_effect" }, { "type": "null" }]
            }
          }
        },
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on_assign", "on_outcome"],
          "properties": {
            "on_assign": {
              "anyOf": [{ "$ref": "#/$defs/notification_setting" }, { "type": "null" }]
            },
            "on_outcome": {
              "anyOf": [{ "$ref": "#/$defs/notification_setting" }, { "type": "null" }]
            }
          }
        },
        "sla": {
          "anyOf": [{ "$ref": "#/$defs/sla" }, { "type": "null" }]
        }
      }
    },

    "completion_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format", "store_as", "target", "template", "channel", "message"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["issue_reference_number", "notify", "instruction_to_requester"]
        },
        "format": { "type": ["string", "null"] },
        "store_as": { "type": ["string", "null"] },
        "target": {
          "anyOf": [{ "$ref": "#/$defs/actor" }, { "type": "null" }]
        },
        "template": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"], "enum": ["email", "sms", "in_app", null] },
        "message": { "type": ["string", "null"] }
      }
    },

    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "required_steps", "actions"],
      "properties": {
        "rule": {
          "type": "string",
          "enum": ["all_required_steps_complete", "any_step_complete", "specific_steps"]
        },
        "required_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/completion_action" }
        }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_from", "source_text_hash", "extraction_model",
        "extraction_timestamp", "confidence", "ambiguities",
        "unmapped_roles", "review_status"
      ],
      "properties": {
        "created_from": { "type": "string", "enum": ["plain_text"] },
        "source_text_hash": { "type": "string" },
        "extraction_model": { "type": "string" },
        "extraction_timestamp": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "ambiguities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unmapped_roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_status": {
          "type": "string",
          "enum": ["pending_admin_review", "confirmed", "rejected"]
        }
      }
    }
  }
}
