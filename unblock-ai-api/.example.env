# Runtime environment: development | production | test
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000
# Allowed CORS origin for browser clients
CORS_ORIGIN=http://localhost:3001
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017
# MongoDB database name
MONGODB_DB=unblock_ai
# Azure OpenAI resource endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Azure OpenAI API key
AZURE_OPENAI_API_KEY=
# Azure OpenAI chat deployment used for extraction
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-10-21
# Chat deployment used by the selector agent (falls back to AZURE_OPENAI_DEPLOYMENT)
AZURE_SELECTOR_DEPLOYMENT=gpt-4o
# Max retry attempts for workflow extraction
EXTRACTION_MAX_ATTEMPTS=3
# Azure AI Foundry embeddings endpoint (separate resource from chat)
AZURE_EMBEDDING_ENDPOINT=https://<your-foundry>.services.ai.azure.com
# Azure AI Foundry embeddings API key
AZURE_EMBEDDING_API_KEY=
# Embedding model deployment name
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Azure AI Foundry embeddings API version
AZURE_EMBEDDING_API_VERSION=2024-10-21
# Expected embedding vector dimensionality
AZURE_EMBEDDING_DIM=1536
# Number of top candidates returned by retrieval
RETRIEVAL_TOP_K=5
# Additive score boost for exact alias matches
RETRIEVAL_ALIAS_BOOST=0.15
# Max clarifying-question rounds before falling back to manual choice
SELECTION_MAX_ROUNDS=2
# Vector search backend: memory | atlas
VECTOR_BACKEND=memory
# Atlas Search index name used when VECTOR_BACKEND=atlas
ATLAS_VECTOR_INDEX=template_vector_index
# Mail transport: console | smtp
MAIL_TRANSPORT=console
# From address used on outgoing approval emails
MAIL_FROM="Unblock AI <noreply@yourdomain>"
# SMTP host (required when MAIL_TRANSPORT=smtp)
SMTP_HOST=
# SMTP port
SMTP_PORT=587
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# Base URL used to build approval links
APP_PUBLIC_URL=http://localhost:3001
# HMAC secret used to sign approval tokens (required when MAIL_TRANSPORT=smtp)
APPROVAL_TOKEN_SECRET=
# Approval token time-to-live, in days
APPROVAL_TOKEN_TTL_DAYS=14
