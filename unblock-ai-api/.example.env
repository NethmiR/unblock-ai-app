# Runtime environment: development | production | test
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000
# Allowed CORS origin(s) for browser clients - comma-separated for multiple.
# Ignored when NODE_ENV=development, which allows any origin unblocked.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017
# MongoDB database name
MONGODB_DB=unblock_ai
# PostgreSQL connection string for auth + deletion tracking
POSTGRES_URL=postgresql://unblock_app:<password>@localhost:5432/unblock_ai_auth
# Max pooled Postgres connections
POSTGRES_POOL_MAX=10
# Postgres connection acquisition timeout, ms
POSTGRES_CONNECTION_TIMEOUT_MS=5000
# Backend for the user, user-session and template-deletion repositories: postgres | memory
POSTGRES_REPOSITORY_BACKEND=postgres
# Bootstrap administrator created by 'npm run seed:pg:run' with every permission.
# Read only by the seed command; the password is USER_DEFAULT_PASSWORD.
SEED_ADMINISTRATOR_EMAIL=
SEED_ADMINISTRATOR_FULL_NAME=
# Seed the sample users (u1@u.c, u2@u.c, ...) with test affiliations. Never enable in production.
SEED_SAMPLE_USERS=false
# Session lifetime, hours
SESSION_TTL_HOURS=12
# Consecutive failed login attempts before locking the account. 0 disables
# enforcement (attempts are still tracked and counted).
AUTH_MAX_FAILED_ATTEMPTS=0
# Minutes an account stays locked after reaching AUTH_MAX_FAILED_ATTEMPTS
AUTH_LOCKOUT_DURATION_MINUTES=15
# Initial password assigned to every newly created user. Required.
USER_DEFAULT_PASSWORD=12345
# LLM provider used for every generation task (workflow template generation, selection): azure-openai | gemini
LLM_PROVIDER=azure-openai
# Azure OpenAI resource endpoint (required when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Azure OpenAI API key (required when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_API_KEY=
# Azure OpenAI API version (required when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure OpenAI chat deployment (required when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# Google AI Studio API key (required when LLM_PROVIDER or EMBEDDING_PROVIDER is gemini)
GEMINI_API_KEY=
# Gemini chat model (required when LLM_PROVIDER=gemini)
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Max attempts (initial + repairs) when generating a workflow template from a prompt
WORKFLOW_TEMPLATE_GENERATION_MAX_ATTEMPTS=3
# Embedding provider: azure-openai | gemini | voyage-ai. Changing it (or the embedding model) requires
# re-embedding every stored template, since vectors from different models are not comparable.
EMBEDDING_PROVIDER=azure-openai
# Azure AI Foundry embeddings endpoint (required when EMBEDDING_PROVIDER=azure-openai)
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-foundry>.services.ai.azure.com
# Azure AI Foundry embeddings API key (required when EMBEDDING_PROVIDER=azure-openai)
AZURE_OPENAI_EMBEDDING_API_KEY=
# Azure AI Foundry embeddings API version (required when EMBEDDING_PROVIDER=azure-openai)
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21
# Embedding model deployment name (required when EMBEDDING_PROVIDER=azure-openai)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Gemini embedding model (required when EMBEDDING_PROVIDER=gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Voyage AI embeddings base URL - https://ai.mongodb.com/v1 for MongoDB Atlas keys,
# https://api.voyageai.com/v1 for Voyage AI dashboard keys (required when EMBEDDING_PROVIDER=voyage-ai)
VOYAGE_AI_EMBEDDING_ENDPOINT=https://ai.mongodb.com/v1
# Voyage AI API key (required when EMBEDDING_PROVIDER=voyage-ai)
VOYAGE_AI_EMBEDDING_API_KEY=
# Voyage AI embedding model (required when EMBEDDING_PROVIDER=voyage-ai)
VOYAGE_AI_EMBEDDING_MODEL=voyage-4
# Embedding vector dimensionality requested from the provider - must match the vector index.
# voyage-ai only accepts 256 | 512 | 1024 | 2048.
EMBEDDING_DIMENSIONS=1536
# Number of top candidates returned by retrieval
RETRIEVAL_TOP_K=5
# Additive score boost for exact alias matches
RETRIEVAL_ALIAS_BOOST=0.15
# Max clarifying-question rounds before falling back to manual choice
SELECTION_MAX_ROUNDS=2
# Vector search backend: memory | atlas
VECTOR_BACKEND=memory
# Atlas Search index name used when VECTOR_BACKEND=atlas
ATLAS_VECTOR_INDEX=template_vector_index
# Mail transport: console | brevo
MAIL_TRANSPORT=console
# From address used on outgoing approval emails
MAIL_FROM="Unblock AI <noreply@yourdomain>"
# Brevo transactional email API key (required when MAIL_TRANSPORT=brevo)
BREVO_API_KEY=
# Base URL used to build approval links
APP_PUBLIC_URL=http://localhost:3001
# HMAC secret used to sign approval tokens (required when MAIL_TRANSPORT=brevo)
APPROVAL_TOKEN_SECRET=
# Approval token time-to-live, in days
APPROVAL_TOKEN_TTL_DAYS=14
# Generate a completion-document PDF record when a task finishes
DOCUMENT_ENABLED=true
# Attach the generated record to the completion email (vs. portal-download only)
DOCUMENT_ATTACH_TO_EMAIL=true
# Document renderer: pdf | text
DOCUMENT_FORMAT=pdf
# Institution name printed on the completion-document footer
DOCUMENT_INSTITUTION_NAME=Unblock AI
# Max attachment size, bytes - larger records are download-only, not attached
DOCUMENT_MAX_ATTACHMENT_BYTES=5000000
