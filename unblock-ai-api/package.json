{
  "name": "unblock-ai-api",
  "version": "1.0.0",
  "description": "Express + TypeScript backend that extracts, stores, retrieves, and helps select institutional approval workflow templates.",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm run build",
    "build": "tsc && tsx scripts/copy-assets.script.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:live": "node --import tsx --test \"tests/live/**/*.test.ts\"",
    "migrate:up": "npm run migrate:pg:up && npm run migrate:mongo:up",
    "migrate:status": "npm run migrate:pg:status && npm run migrate:mongo:status",
    "migrate:pg:up": "tsx scripts/db/migrate-postgres.script.ts up",
    "migrate:pg:down": "tsx scripts/db/migrate-postgres.script.ts down",
    "migrate:pg:reset": "tsx scripts/db/migrate-postgres.script.ts reset",
    "migrate:pg:status": "tsx scripts/db/migrate-postgres.script.ts status",
    "migrate:pg:create": "tsx scripts/db/migrate-postgres.script.ts create",
    "migrate:pg:unlock": "tsx scripts/db/migrate-postgres.script.ts unlock",
    "migrate:mongo:up": "tsx scripts/db/migrate-mongo.script.ts up",
    "migrate:mongo:down": "tsx scripts/db/migrate-mongo.script.ts down",
    "migrate:mongo:reset": "tsx scripts/db/migrate-mongo.script.ts reset",
    "migrate:mongo:status": "tsx scripts/db/migrate-mongo.script.ts status",
    "migrate:mongo:create": "tsx scripts/db/migrate-mongo.script.ts create",
    "migrate:mongo:unlock": "tsx scripts/db/migrate-mongo.script.ts unlock",
    "seed:pg:run": "tsx scripts/db/seed-postgres.script.ts run",
    "seed:pg:list": "tsx scripts/db/seed-postgres.script.ts list",
    "seed:pg:create": "tsx scripts/db/seed-postgres.script.ts create",
    "backfill:summaries": "tsx scripts/maintenance/backfill-summaries.script.ts",
    "evaluate:selection": "tsx tests/evaluation/evaluate-selection.script.ts",
    "perf-test": "tsx tests/perf/perf-test.script.ts",
    "smoke-test:llm": "tsx tests/smoke/smoke-test-llm.script.ts",
    "smoke-test:embeddings": "tsx tests/smoke/smoke-test-embeddings.script.ts",
    "smoke-test:mail": "tsx tests/smoke/smoke-test-mail.script.ts",
    "smoke-test:document": "tsx tests/smoke/smoke-test-document.script.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "openai": "^7.1.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
